# ==============================================================================
# GraphRAG System Environment Variables (Example Template)
# ==============================================================================

# --- 1. LLM Gateway & API Endpoint ---
# Any OpenAI-compatible endpoint can be used:
# - NVIDIA NIM:  "https://integrate.api.nvidia.com/v1"
# - OpenRouter:  "https://openrouter.ai/api/v1"
# - Local vLLM:  "http://localhost:8000/v1"
# - Ollama:      "http://localhost:11434/v1"
LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
LLM_API_KEY="your_api_key_here"

# --- 2. Model Selection for the 3 Core Engines ---
# Engine 1: Fact & Relation Extraction (JSON schema extraction from chunks into ontology)
# Options: "nvidia/nemotron-3-super-120b-a12b" | "nvidia/nemotron-3-ultra-550b-a55b"
EXTRACTION_MODEL="nvidia/nemotron-3-super-120b-a12b"

# Engine 2: Question Intent Router (Classifies queries into graph vs vector vs both)
# Options: "nvidia/nemotron-3-super-120b-a12b" | "nvidia/nemotron-3-ultra-550b-a55b"
ROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b"

# Engine 3: Grounded Answer Synthesis (Generates answers strictly citing retrieved chunk IDs)
# Options: "nvidia/nemotron-3-super-120b-a12b" | "nvidia/nemotron-3-ultra-550b-a55b"
SYNTHESIS_MODEL="nvidia/nemotron-3-super-120b-a12b"

# --- 3. Dense Vector Embeddings ---
# CRITICAL: EMBEDDING_DIMENSION MUST match the exact output dimension of EMBEDDING_MODEL!
# If you change EMBEDDING_MODEL, verify its vector length and update EMBEDDING_DIMENSION:
# - "nvidia/nemotron-3-embed-1b"      -> 2048
# - "openai/text-embedding-3-small"    -> 1536
# - "BAAI/bge-large-en-v1.5"           -> 1024
# - "sentence-transformers/all-MiniLM" -> 384
EMBEDDING_MODEL="nvidia/nemotron-3-embed-1b"
EMBEDDING_DIMENSION=2048

# --- Neo4j Graph Database Configuration ---
NEO4J_URI="bolt://127.0.0.1:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="graphrag_password"

# --- PostgreSQL / pgvector Database Configuration ---
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="graphrag_db"
POSTGRES_USER="graphrag_user"
POSTGRES_PASSWORD="graphrag_password"

# --- Ingestion & Rate Limit Configuration ---
# arXiv strictly limits requests to max 1 request per 3.0s over a single connection
ARXIV_DELAY_SECONDS=3.0
ARXIV_USER_AGENT="Enterprise-GraphRAG-Research/1.0 (contact: research@enterprise.local)"
ARXIV_ACKNOWLEDGMENT="Thank you to arXiv for use of its open access interoperability."
SEMANTIC_SCHOLAR_API_KEY=""

# --- Application Server ---
APP_HOST="0.0.0.0"
APP_PORT=8000
DEBUG=false
LOG_LEVEL="INFO"
